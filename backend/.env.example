APP_NAME=Let's Do API
APP_ENVIRONMENT=development
APP_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://lets_do_api:replace-me@localhost:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/postgres
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Production database URLs must include sslmode=require, sslmode=verify-ca, or
# sslmode=verify-full. Configure only the exact HTTPS frontend origin in CORS_ALLOWED_ORIGINS.
